# LLM Provider: 'openai_compatible', 'azure', or 'openai'
LLM_PROVIDER=openai_compatible

# LiteLLM / vLLM Gateway Settings
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=sk-dummy-key
OPENAI_MODEL=bbl-report-generator

# Azure OpenAI Settings 
# AZURE_OPENAI_ENDPOINT=https://oaibblinnocandiddate01.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_subscription_key_here
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Feature Toggles
SHOW_RETRIEVED_SNIPPETS=true
