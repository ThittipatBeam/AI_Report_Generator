# LLM Provider Options: 'openai_compatible', 'azure', 'openai' or 'apim_azure'
LLM_PROVIDER=apim_azure


OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# DISPLAY_MODEL_NAME: The model name shown in Open WebUI dropdown menu
DISPLAY_MODEL_NAME=AI_Report_Generator

# Azure OpenAI Settings (Used when LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://oaibblinnocandiddate01.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_subscription_key_here
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Bangkok Bank APIM Azure Settings (Used when LLM_PROVIDER=apim_azure)
APIM_AZURE_ENDPOINT=https://your_apim_endpoint/llm/responses
APIM_AZURE_API_KEY=your_apim_api_key_here
APIM_AZURE_MODEL=gpt-5-mini

# Feature Toggles (Show/hide collapsible source context in responses)
SHOW_RETRIEVED_SNIPPETS=true


